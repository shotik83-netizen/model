{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-data.schema.json",
  "title": "Financial economic model configuration",
  "type": "object",
  "required": ["application", "schemaVersion", "unit", "contractors"],
  "properties": {
    "application": { "const": "financial-economic-model" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "unit": { "type": "number", "exclusiveMinimum": 0 },
    "contractors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "fileUrl"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "fileUrl": { "type": "string", "pattern": "^data/contractors/.+\\.xlsx$" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

